# Harmos Sovereign Gateway Environment Variables
# USPTO Patent #63/915,788

# Server Configuration
HARMOS_HOST=127.0.0.1
HARMOS_PORT=8001
HARMOS_ENV=development
HARMOS_LOG_LEVEL=info

# Database Path (default is apps/gateway/harmos.db)
HARMOS_DB_PATH=apps/gateway/harmos.db

# Security & Zero-Trust Authentication
HARMOS_API_KEY=harmos_sec_key_sample_9901
HARMOS_REQUIRE_AUTH=false

# PQC Signature Seed (Deterministic key derivation across container restarts)
HARMOS_SIGNER_SEED=harmos_sovereign_runtime_master_seed_2026_x89

# Upstream AI Model Proxy (Optional for pass-through evaluation)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
